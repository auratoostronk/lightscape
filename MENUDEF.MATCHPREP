		Command "set ls_startweap 3"
		Pos -96, 48
		Size 32, 32
		Background "ARROWLF"
		SelectedBackground "ARROWLF2"
	}
	Label
	{
		Pos -128, 112
		Size 256, 16
		Font BIGFONT
		FontColor Red
		MaxTextWidth 256
		Anchor left, top
		Text "> DESCRIPTION"
	}
	
	//Plasma Carbine
	Label
	{
		Background "BG_WEAP"
		VisibilityCVar ls_startweap, 0, 0
		Pos -128, 128
		Size 256, 64
		MaxTextWidth 224
		Anchor left, top
		Padding 12, 12
		Font SMALLFNT
		FontColor Red
		Text "Fires high-speed plasma pellets at a high rate of fire. Alt-Fire lobs an arcing powerful energy bomb."
	}
	//Particle Splitter
	Label
	{
		Background "BG_WEAP"
		VisibilityCVar ls_startweap, 1, 1
		Pos -128, 128
		Size 256, 64
		MaxTextWidth 224
		Anchor left, top
		Padding 12, 12
		Font SMALLFNT
		FontColor Red
		Text "Projectile-based shotgun with limitted range. Alt-fire fires a tighter spread."
	}
	//Tesla SMG
	Label
	{
		Background "BG_WEAP"
		VisibilityCVar ls_startweap, 2, 2
		Pos -128, 128
		Size 256, 64
		MaxTextWidth 224
		Anchor left, top
		Padding 12, 12
		Font SMALLFNT
		FontColor Red
		Text "Fires slow-moving electric projectiles while pulling the user forward. Alt-fire to unleash a powerful electric melee attack."
	}
	//C-14
	Label
	{
		Background "BG_WEAP"
		VisibilityCVar ls_startweap, 3, 3
		Pos -128, 128
		Size 256, 64
		MaxTextWidth 224
		Anchor left, top
		Padding 12, 12
		Font SMALLFNT
		FontColor Red
		Text "Fires arcing radioactive projectiles that deal area damage on impact. Alt-fire lobs an acidic gas canister."
	}
	//Railgun
	Label
	{
		Background "BG_WEAP"
		VisibilityCVar ls_startweap, 4, 4
		Pos -128, 128
		Size 256, 64
		MaxTextWidth 224
		Anchor left, top
		Padding 12, 12
		Font SMALLFNT
		FontColor Red
		Text "Fires a powerful railgun attack with a slow rate of fire. Alt-fire blasts an orb that knocks enemies away."
	}
	Command
	{
		Command "upmenu"
		Pos -72, 208
		Padding 0, 8
		Size 128, 32
		Font BIGFONT
		FontColor Red
		SelectedFontColor White
		Background "BG_NEXT"
		SelectedBackground "BG_NEXT2"
		Text "<<< BACK"
	}
	Submenu
	{
		Menu "MatchPrepDash"
		Pos 72, 208
		Padding 0, 8
		Size 128, 32
		Font BIGFONT
		FontColor Red
		SelectedFontColor White
		Background "BG_NEXT"
		SelectedBackground "BG_NEXT2"
		Text "NEXT >>>"
	}
}

