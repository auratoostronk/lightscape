		Pos -96, 48
		Size 32, 32
		Background "ARROWLF"
		SelectedBackground "ARROWLF2"
	}
	//C14 Arrows
	Command
	{
		VisibilityCVar ls_startweap, 3, 3
		Command "set ls_startweap 4"
		Pos 96, 48
		Size 32, 32
		Background "ARROWRT"
		SelectedBackground "ARROWRT2"
	}
	Command
	{
		VisibilityCVar ls_startweap, 3, 3
		Command "set ls_startweap 2"
		Pos -96, 48
		Size 32, 32
		Background "ARROWLF"
		SelectedBackground "ARROWLF2"
	}
	//Railgun Arrows
	Command
	{
		VisibilityCVar ls_startweap, 4, 4
		Command "set ls_startweap 0"
		Pos 96, 48
		Size 32, 32
		Background "ARROWRT"
		SelectedBackground "ARROWRT2"
