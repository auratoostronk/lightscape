//PROJECTILES

//Plasma Carbine
//Objects
object PlasmaProjectile
{
	frame BSPK { light CarbineProjectileLight }
}
object PlasmaGrenade
{
	frame BGRN { light CarbineGrenadeLight }
}
object PlasmaGrenadeDeathDot
{
	frame BSPK { light CarbineDotLight }
}
object PlasmaDeathFX
{
	frame BSPK { light CarbineDotLight }
}

//Lights
pointlight CarbineProjectileLight
{
    color 0.0 0.0 1.0
    size 32
}
PointLight CarbineGrenadeLight
{
    color 0.0 0.0 1.0
    size 32
}
Pointlight CarbineDotLight
{
    color 0.0 0.0 1.0
    size 4
}

