Script "UseActive" (void) NET
{
	if(ClassifyActor(0) & ACTOR_ALIVE)
	{
		//if(PLAYER_ACTIVECD[PlayerNumber()] == 0)
		if(CheckInventory("ActiveCDSeconds") == 0)
		{
			for(int i = 0; i < NUM_ACTIVES; i++)
			{
				if(CheckInventory(ACTIVE_INVENTORY[i]) > 0)
				{
					//PLAYER_ACTIVECD[PlayerNumber()] = ACTIVE_CDS[i];
					//ACS("SyncActiveCD", ACTIVE_CDS[i]);
					GiveInventory("ActiveCDSeconds", ACTIVE_CDS[i]);
					ACS(ACTIVE_SCRIPTS[i]);
					terminate;
				}
			}
		}
		else
		{
			LocalAmbientSound("Feedback/Error", 64);
		}
	}
}

Script "BotActive" ENTER
{
	while(true)
	{
		If(ClassifyActor(0) & ACTOR_BOT)
		{
			if(random(0, 35) * 5 == 0)
			{
				Acs("UseActive");
			}
		}
		delay(1);
	}
}

Script "RegenZone" (void)
{
	SpawnSpotFacingForced("RZoneSpawner", 0, 0);
}

Script "FlickerShield" (void)
{
	GiveInventory("FShield", 1);
	int atid = ActivatorTID();
	int utid = UniqueTID(UTID_MIN, UTID_LIMIT);
	SpawnSpotFacingForced("FShieldFX", atid, utid);
	SetActivator(utid);
	SetPointer(AAPTR_TARGET, atid);
	for(int i = 0; i < 35; i++)
	{
		Warp(atid, 0, 0, 0, 0.0, WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE);
		delay(1);
		if(!(ClassifyActor(atid) & ACTOR_ALIVE))
		{
			i = 35;
		}
	}
	SetActivator(atid);
	TakeInventory("FShield", 1);
	Thing_Remove(utid);
}

