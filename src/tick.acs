function void tickActionCD(void)
{
	GiveInventory("ActiveCDTics", 1);
	if(CheckInventory("ActiveCDTics") >= 35)
	{
		TakeMax("ActiveCDTics");
		TakeInventory("ActiveCD", 1);
	}
}

function void tickAltCD(void)
{
	TakeInventory("AltFireCD", 1);
	if(CheckInventory("AltFireCD") == 0)
	{
		TakeMax("AltFireCDMax");
	}
}

script "CooldownTimers" ENTER
{
	while(true)
	{
		if(ClassifyActor(0) & ACTOR_ALIVE)
		{
			TakeInventory("OmniDashCD", 1);
			TakeInventory("WarpDashCD", 1);
			TakeInventory("HRailCharge", 1);
			tickAmmoRegen();
			tickHealthRegen();
			bandolierCheck();
			tickActionCD();
			tickAltCD();
			
			/*if(CheckInventory("IsDashing") > 0)
			{
				SpawnSpotFacingForced("DashTrail", 0, 0);
				TakeInventory("IsDashing", 1);
			}*/
		}
		delay(1);
	}
}